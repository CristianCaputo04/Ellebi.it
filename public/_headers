# Intestazioni HTTP servite da Cloudflare Pages.
# Sintassi: un percorso, poi le intestazioni indentate di due spazi.
#
# Il consenso cookie è delegato a iubenda (Cookie Solution + Privacy/Cookie
# Policy incorporata): script-src/connect-src/style-src/frame-src/img-src
# concedono *.iubenda.com secondo la guida ufficiale
# https://www.iubenda.com/it/help/12260 — 'unsafe-eval' e 'unsafe-inline'
# (stile) sono richiesti dai loro script, non da codice nostro. L'hash del
# frammento di configurazione inline (_iub.csConfiguration) è calcolato da
# tools/aggiorna-csp-hash.py insieme a quelli dei blocchi JSON-LD.
# Cross-Origin-Embedder-Policy è stato rimosso: l'iframe di incorporamento
# della policy iubenda non garantisce l'header CORP richiesto da COEP.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https://*.iubenda.com; style-src 'self' 'unsafe-inline' https://*.iubenda.com; font-src 'self'; script-src 'self' 'sha256-M7XfOvnn9N8l/vRGsFu1S4mV1rHiZ7SrvCGLTfe4iSo=' 'sha256-qOhFsq0QMV2REqNwk5hGH5bZE9SkX6gt6yeyKdYPv+U=' 'sha256-pI95qKXRYXqkPcLotjiz3zwu0VcYIsqdt9rWYqUclE8=' 'sha256-3LaWAOJG9VwG19Cz4WsZrmAq4wxiftPIjZ8l+xiaDlQ=' 'sha256-FQtiB8mnvR11sGcNWoz7N70RwpCmV5Bfr3Zw4YqaiiI=' 'sha256-L66LK8AfxfOcOl/6/skx6sLWqtLqjvKsAI+2Ua5oT1Y=' 'sha256-bh3Xi4ByTN/1VcJqV94LaqN+CEqLKB9hNfuSSxBH+6I=' 'sha256-G1c4dVlpZa9nelX/Sdd+Zx9bi5D3z463RfgtgHNMqy4=' 'sha256-CFoGOjgP8QFiO3a9Z/DF+p6JQOMFZb8nb25NmWzgnNA=' 'sha256-4YkTVFRUkLWYTjMQ+xIGIR3GzmDs8zeZh0YiJAMdw4g=' 'unsafe-eval' https://*.iubenda.com; connect-src 'self' https://*.iubenda.com; manifest-src 'self'; frame-src https://*.iubenda.com; media-src 'none'; worker-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: off

# Le pagine HTML devono essere sempre riconvalidate: gli aggiornamenti
# pubblicati via commit compaiono subito, senza attendere la cache.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# CSS e JS sono richiamati con una marca di versione calcolata dal contenuto
# (style.css?v=4a7e365431): a ogni modifica l'indirizzo cambia, quindi il file
# a un dato indirizzo non cambierà mai più e si può tenere per un anno senza
# nemmeno chiedere al server se è ancora buono. Le visite successive partono
# senza toccare la rete.
# La marca la riallinea tools/aggiorna-versioni.py, e la pubblicazione si
# ferma se qualcuno se ne dimentica: senza quel controllo "immutable" sarebbe
# un modo per lasciare le persone con lo stile vecchio per un anno.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
